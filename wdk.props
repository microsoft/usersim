<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Set target framework for C++ projects using PackageReference -->
  <PropertyGroup Label="NuGet">
    <TargetFramework>native</TargetFramework>
    <_NuGetTargetFallbackMoniker>$(_NuGetTargetFallbackMoniker);native,Version=v0.0</_NuGetTargetFallbackMoniker>
    <RestorePackages>true</RestorePackages>
    <RestoreProjectStyle>PackageReference</RestoreProjectStyle>
    <HostPlatform Condition="'$(HostPlatform)' == ''">$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)</HostPlatform>
    <!-- Windows SDK target platform version -->
    <UsersimWindowsTargetPlatformVersion Condition="'$(VisualStudioVersion)' == '18.0'">10.0.28000.0</UsersimWindowsTargetPlatformVersion>
    <UsersimWindowsTargetPlatformVersion Condition="'$(VisualStudioVersion)' == '17.0'">10.0.26100.0</UsersimWindowsTargetPlatformVersion>
    <UsersimWindowsTargetPlatformVersion Condition="'$(UsersimWindowsTargetPlatformVersion)' == ''">10.0.26100.0</UsersimWindowsTargetPlatformVersion>
    <!-- WDK NuGet package version: VS 2026 (MSBuild 18) requires 10.0.28000.2526;
         VS 2022 (MSBuild 17) uses 10.0.26100.6584. -->
    <UsersimWDKVersion Condition="'$(VisualStudioVersion)' == '18.0'">10.0.28000.2526</UsersimWDKVersion>
    <UsersimWDKVersion Condition="'$(VisualStudioVersion)' == '17.0'">10.0.26100.6584</UsersimWDKVersion>
    <UsersimWDKVersion Condition="'$(UsersimWDKVersion)' == ''">10.0.26100.6584</UsersimWDKVersion>
    <!-- Platform toolset -->
    <UsersimPlatformToolset Condition="'$(VisualStudioVersion)' == '18.0'">v145</UsersimPlatformToolset>
    <UsersimPlatformToolset Condition="'$(VisualStudioVersion)' == '17.0'">v143</UsersimPlatformToolset>
    <UsersimPlatformToolset Condition="'$(UsersimPlatformToolset)' == ''">v143</UsersimPlatformToolset>
    <_UsersimTargetPackagePlatform Condition="'$(Platform)' != ''">$(Platform.ToLowerInvariant())</_UsersimTargetPackagePlatform>
    <_UsersimTargetPackagePlatform Condition="'$(Platform)' == 'Win32'">x86</_UsersimTargetPackagePlatform>
    <_UsersimTargetPackagePlatform Condition="'$(_UsersimTargetPackagePlatform)' == ''">x64</_UsersimTargetPackagePlatform>
    <_UsersimHostPackagePlatform>$(HostPlatform.ToLowerInvariant())</_UsersimHostPackagePlatform>
    <_UsersimHostPackagePlatform Condition="'$(_UsersimHostPackagePlatform)' == 'amd64'">x64</_UsersimHostPackagePlatform>
    <_UsersimHostPackagePlatform Condition="'$(_UsersimHostPackagePlatform)' == 'win32'">x86</_UsersimHostPackagePlatform>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Windows.SDK.CPP"
                      Version="[$(UsersimWDKVersion)]"
                      PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.CPP.$(_UsersimTargetPackagePlatform)"
                      Version="[$(UsersimWDKVersion)]"
                      PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.WDK.$(_UsersimTargetPackagePlatform)"
                      Version="[$(UsersimWDKVersion)]"
                      PrivateAssets="all" />
    <PackageReference Include="Microsoft.Windows.SDK.CPP.$(_UsersimHostPackagePlatform)"
                      Version="[$(UsersimWDKVersion)]"
                      PrivateAssets="all"
                      Condition="'$(_UsersimHostPackagePlatform)' != '$(_UsersimTargetPackagePlatform)'" />
    <PackageReference Include="Microsoft.Windows.WDK.$(_UsersimHostPackagePlatform)"
                      Version="[$(UsersimWDKVersion)]"
                      PrivateAssets="all"
                      Condition="'$(_UsersimHostPackagePlatform)' != '$(_UsersimTargetPackagePlatform)'" />
  </ItemGroup>
</Project>